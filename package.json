{
  "name": "premiere-mcp-bridge",
  "version": "1.0.1",
  "description": "MCP server for Adobe Premiere Pro — control Premiere Pro from Claude, Codex, or any MCP client via 170+ tools over a local WebSocket + CEP bridge",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "premiere-mcp-bridge": "dist/cli.js"
  },
  "files": [
    "dist",
    "cep",
    "config.example.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsc --watch",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "premiere-pro",
    "adobe",
    "video-editing",
    "claude",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dinushan-S/premiere-mcp-bridge.git"
  },
  "homepage": "https://github.com/Dinushan-S/premiere-mcp-bridge#readme",
  "bugs": {
    "url": "https://github.com/Dinushan-S/premiere-mcp-bridge/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.3"
  }
}
